#!/bin/bash
# mic-warmctl
# Start, stop, or check the mic-warm LaunchAgent without uninstalling it.
#
#   mic-warmctl stop     Stop mic-warm and keep it off, including after login
#   mic-warmctl start    Start mic-warm and run it at login again
#   mic-warmctl restart  Restart the running agent
#   mic-warmctl status   Show whether it is running and which mic it holds

set -euo pipefail

LABEL="com.user.keep-mic-warm"
DOMAIN="gui/$(id -u)"
SERVICE="$DOMAIN/$LABEL"
PLIST_PATH="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG_PATH="$HOME/Library/Logs/mic-warm.log"

is_loaded() {
    launchctl print "$SERVICE" >/dev/null 2>&1
}

running_pid() {
    # Not loaded means no PID; don't let pipefail abort the caller.
    { launchctl print "$SERVICE" 2>/dev/null || true; } | awk '/^\tpid = / { print $3 }'
}

require_plist() {
    if [ ! -f "$PLIST_PATH" ]; then
        echo "mic-warm is not installed ($PLIST_PATH not found)."
        echo "Run ./local-install.sh from the repo first."
        exit 1
    fi
}

cmd_stop() {
    require_plist
    # disable keeps launchd from loading the agent at the next login.
    launchctl disable "$SERVICE"
    if is_loaded; then
        launchctl bootout "$SERVICE"
    fi
    echo "mic-warm stopped. It stays off until you run: mic-warmctl start"
}

cmd_start() {
    require_plist
    launchctl enable "$SERVICE"
    if is_loaded; then
        echo "mic-warm is already running (PID: $(running_pid))."
        return
    fi
    launchctl bootstrap "$DOMAIN" "$PLIST_PATH"
    sleep 1
    echo "mic-warm started (PID: $(running_pid))."
}

cmd_restart() {
    require_plist
    if ! is_loaded; then
        cmd_start
        return
    fi
    launchctl kickstart -k "$SERVICE"
    sleep 1
    echo "mic-warm restarted (PID: $(running_pid))."
}

cmd_status() {
    if [ ! -f "$PLIST_PATH" ]; then
        echo "mic-warm: not installed"
        return
    fi
    # grep without -q reads all input, so launchctl never hits SIGPIPE under pipefail.
    if launchctl print-disabled "$DOMAIN" 2>/dev/null | grep "\"$LABEL\" => disabled" >/dev/null; then
        local login="off at login"
    else
        local login="starts at login"
    fi
    local pid
    pid="$(running_pid)"
    if [ -n "$pid" ]; then
        echo "mic-warm: running (PID: $pid), $login"
        grep "Keeping warm:" "$LOG_PATH" 2>/dev/null | tail -1 | sed -e 's/.*Keeping warm: /mic:      /' -e 's/ (isRunning=.*)$//' || true
    else
        echo "mic-warm: stopped, $login"
    fi
}

case "${1:-status}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    *)
        echo "Usage: mic-warmctl {start|stop|restart|status}"
        exit 2
        ;;
esac
